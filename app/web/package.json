    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "^24.12.4",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.9.0",
    "lucide-svelte": "1.0.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "dependencies": {
