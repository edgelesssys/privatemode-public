+class StagedH2DBuffer:
+    """Explicit-copy buffer for GPU Confidential Computing.
+
+    Like `NonUvaBuffer`, but issues the H2D on the prep stream (see
+    vllm.v1.conf_compute_utils). Rewriting the device tensor in place relies on
+    the pool invariant that no GPU reader of a slot is in flight when the slot
+    is reused.
+    """
+
+    def __init__(self, size: int | Sequence[int], dtype: torch.dtype):
+        from vllm.platforms import current_platform
+        from vllm.v1.conf_compute_utils import prep_stream
+
+        self.cpu = torch.zeros(size, dtype=dtype, device="cpu", pin_memory=True)
+        self.np = self.cpu.numpy()
+        device = torch.device(
+            current_platform.device_type, torch.accelerator.current_device_index()
+        )
+        # Allocated on the prep stream, which writes it.
+        with torch.inference_mode(False), torch.cuda.stream(prep_stream(device)):
+            self._gpu = torch.zeros(size, dtype=dtype, device=device)
+
+    def uva(self, n: int | None = None) -> torch.Tensor:
+        from vllm.v1.conf_compute_utils import prep_stream
+
+        cpu, gpu = (self.cpu, self._gpu) if n is None else (self.cpu[:n], self._gpu[:n])
+        if torch.cuda.is_current_stream_capturing():
+            # See staged_h2d(): copy on the capturing stream instead.
+            return gpu.copy_(cpu, non_blocking=True)
+        prep = prep_stream(gpu.device)
+        with torch.cuda.stream(prep):
+            gpu.copy_(cpu, non_blocking=True)
+        # See staged_h2d(): order the readers after the copy.
+        torch.cuda.current_stream(gpu.device).wait_stream(prep)
+        return gpu
+
+
