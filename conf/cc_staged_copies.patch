@@ -0,0 +1,77 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Copy helpers for GPU Confidential Computing.
+
+Under Confidential Computing, host<->device copies go through encrypted bounce
+buffers, and a pinned ``cudaMemcpyAsync`` is host-synchronous: the issuing
+thread blocks until the copy *and everything already queued on its stream* has
+completed. An H2D input copy on the compute stream therefore stalls the host for
+the in-flight forward pass, and a D2H readback stalls the thread that issues it.
+
+``staged_h2d`` issues uploads on a separate, idle prep stream, so the host only
+waits for the transfer itself, and orders the compute stream after it. Adapted
+from vllm-project/vllm#59981. Privatemode always runs under Confidential
+Computing, so this path is used unconditionally, also in tests without it.
+"""
+
+from functools import cache
+
+import torch
+
+
+@cache
+def _prep_stream_for_index(device_index: int) -> torch.cuda.Stream:
+    return torch.cuda.Stream(device=torch.device("cuda", device_index))
+
+
+def prep_stream(device: torch.device) -> torch.cuda.Stream:
+    """Return the prep stream of `device`.
+
+    One stream per device suffices: it only carries uploads, which are
+    host-synchronous under Confidential Computing, so it is drained by the
+    time each copy call returns.
+    """
+    index = (
+        device.index
+        if device.index is not None
+        else torch.accelerator.current_device_index()
+    )
+    return _prep_stream_for_index(index)
+
+
+def staged_h2d(
+    src: torch.Tensor,
+    *,
+    device: torch.device | str | None = None,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Upload a host tensor without waiting for the compute stream.
+
+    The H2D runs on the prep stream and the current (compute) stream waits for
+    it. Without `out`, the new device tensor is returned; `record_stream` keeps
+    the caching allocator from reusing it before the compute stream is done
+    with it. With `out`, a device-to-device copy on the compute stream moves
+    the data into `out`, ordered after earlier readers of `out`.
+
+    `src` must already have the destination dtype: a converting copy would run
+    its cast kernel on the prep stream.
+    """
+    target = out.device if out is not None else torch.device(device)  # type: ignore[arg-type]
+    if torch.cuda.is_current_stream_capturing():
+        # A cross-stream copy cannot be captured into the graph: copy on the
+        # capturing stream, as without Confidential Computing.
+        if out is None:
+            return src.to(device=target, non_blocking=True)
+        return out.copy_(src, non_blocking=True)
+    compute = torch.cuda.current_stream(target)
+    prep = prep_stream(target)
+    with torch.cuda.stream(prep):
+        staged = src.to(device=target, non_blocking=True)
+    # is_pinned() reports False under Confidential Computing even for pinned
+    # allocations, so whether the copy was host-synchronous is unknown here.
+    # Always order the compute stream after the prep stream.
+    compute.wait_stream(prep)
+    staged.record_stream(compute)
+    if out is None:
+        return staged
+    return out.copy_(staged, non_blocking=True)
