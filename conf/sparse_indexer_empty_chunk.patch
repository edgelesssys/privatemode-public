+def chunk_token_range(
+    query_start_loc_cpu: torch.Tensor, req_slice: slice, query_slice: slice
+) -> tuple[int, int]:
+    """Batch token range of the ``query_slice`` rows of requests ``req_slice``."""
+    start = int(query_start_loc_cpu[req_slice.start])
+    num_tokens = int(query_start_loc_cpu[req_slice.stop]) - start
+    return (
+        start + min(query_slice.start, num_tokens),
+        start + min(query_slice.stop, num_tokens),
+    )
