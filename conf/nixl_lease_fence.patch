+    def _lease_deadline(self, meta: ReqMeta) -> float | None:
+        """Local time by which this request's READs must complete (#61229).
+
+        None if unfenced: the producer exports no lease expiry, or the request
+        reads nothing. -inf if the exported expiry is missing or invalid.
+        """
+        assert meta.remote is not None
+        fence = self._lease_fences.get(meta.remote.engine_id)
+        if fence is None or not any(
+            len(group) > 0 for group in meta.local_physical_block_ids
+        ):
+            return None
+        clock_offset, margin = fence
+        expiry = meta.remote.blocks_expiry_time
+        # The expiry is client-controllable.
+        try:
+            if isinstance(expiry, (int, float)) and math.isfinite(expiry):
+                return float(expiry) - clock_offset - margin
+        except OverflowError:
+            pass
+        return float("-inf")
+
+    def _decline_late_recvs(self, done_recving: set[str]) -> set[str]:
+        """Completed pulls whose READs may have outlived the producer's lease.
+
+        A kept pull finished every READ before P's expiry-based free, provided
+        the handshake clock-offset error stays below the margin: P frees on
+        expiry no earlier than its exported expiry, and completion is observed
+        here no earlier than it happened. Frees triggered by consumer
+        notifications are not detected, so a duplicate read of one lease
+        passes.
+        """
+        now = time.perf_counter()
+        late: set[str] = set()
+        for req_id in done_recving:
+            deadline = getattr(self._recving_metadata.get(req_id), "lease_fence", None)
+            if (
+                not isinstance(deadline, float)
+                or now < deadline
+                or req_id in self._recv_failures
+            ):
+                continue
+            logger.error(
+                "Declining KV pulled for %s: the READ completed %.1fs after the "
+                "producer's lease fence; the blocks may have been reused.",
+                req_id,
+                now - deadline,
+            )
+            self.xfer_stats.record_kv_expired_req()
+            late.add(req_id)
+        return late
