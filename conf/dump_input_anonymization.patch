+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Helpers for obfuscating request content in crash dumps.
+
+See `vllm.logging_utils.dump_input` and the `anon_repr` methods it dispatches
+to.
+"""
+
+import contextlib
+import contextvars
+from collections.abc import Iterator
+
+_mm_hash_indices: contextvars.ContextVar[dict[str, int] | None] = (
+    contextvars.ContextVar("_mm_hash_indices", default=None)
+)
+
+
+@contextlib.contextmanager
+def anonymization_scope() -> Iterator[None]:
+    """Number multi-modal hashes afresh within this scope; see `anon_mm_hash`."""
+    token = _mm_hash_indices.set({})
+    try:
+        yield
+    finally:
+        _mm_hash_indices.reset(token)
+
+
+def anon_mm_hash(value: str | None) -> str | None:
+    """Replace a multi-modal content hash with a per-dump index label.
+
+    Equal hashes map to the same label within one `anonymization_scope`, so a
+    dump can correlate items without revealing the hashes. Outside any scope,
+    each call numbers against a throwaway table, so labels carry no correlation.
+    """
+    if value is None:
+        return None
+    indices = _mm_hash_indices.get()
+    if indices is None:
+        indices = {}
+    index = indices.setdefault(value, len(indices))
+    return f"mm#{index}"
+
+
+def tensor_repr_no_data(value: object) -> str:
+    """Describe a tensor by shape, device and dtype; others fail closed to type."""
+    import torch
+
+    if not isinstance(value, torch.Tensor):
+        return f"{type(value).__name__}(...)"
+    return f"Tensor(shape={value.shape}, device={value.device},dtype={value.dtype})"
